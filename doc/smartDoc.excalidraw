      "text": "[\n    {\n    name: smartdoc\n    from: /smartdoc/*\n    to: localhost:456 (smartdoc backend)\n    authenticated: true\n    permissions: \n        - view-typeA\n        - edit-typeB\n        - ...\n    },\n    { ... }\n]",
